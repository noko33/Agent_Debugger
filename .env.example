# Copy to .env and replace the placeholder before starting Docker Compose.
POSTGRES_USER=agent_debugger
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=agent_debugger
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# These URLs are browser-facing. Update them if you change the ports above.
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For native backend development, copy backend/.env.example to backend/.env.
# DATABASE_URL can override the individual POSTGRES_* settings in native runs.
# URL-encode any reserved characters in credentials.
# DATABASE_URL=postgresql://agent_debugger:<url-encoded-local-password>@localhost:5432/agent_debugger
