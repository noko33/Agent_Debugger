# Copy to backend/.env for native development. Never commit real credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent_debugger
POSTGRES_DB=agent_debugger
POSTGRES_PASSWORD=replace-with-a-local-password
CORS_ORIGINS=["http://localhost:3000"]
# Alternatively use DATABASE_URL. URL-encode reserved characters in DSN credentials.
# DATABASE_URL=postgresql://agent_debugger:<encoded-password>@localhost:5432/agent_debugger
# Optional integration-test DSN: use a disposable PostgreSQL database.
# TEST_DATABASE_URL=postgresql://agent_debugger:<encoded-password>@localhost:5432/agent_debugger_test

# Native backend diagnostics: optional validated thresholds (defaults shown).
DIAGNOSTICS__REPEATED_TOOL_FAILURE_THRESHOLD=2
DIAGNOSTICS__RETRY_LOOP_THRESHOLD=3
DIAGNOSTICS__SLOW_OPERATION_MS=1000
DIAGNOSTICS__MAX_SPANS=5000

# Phase 5A: native backend; disabled unless explicitly enabled by the operator.
# Per-request external-processing consent is also required. Keep keys server-side.
AI__ENABLED=false
AI__API_KEY=
AI__BASE_URL=https://api.deepseek.com
AI__MODEL=deepseek-chat
AI__TIMEOUT_SECONDS=10
AI__MAX_RETRIES=1
AI__MAX_OUTPUT_TOKENS=1000
AI__MAX_INPUT_TOKENS=16000
AI__MAX_CONTEXT_BYTES=24000
AI__MAX_CONTEXT_SPANS=100
AI__MAX_CONTEXT_FINDINGS=50
AI__MAX_RESPONSE_BYTES=65536
AI__COOLDOWN_SECONDS=30
AI__MAX_CONCURRENT=2
